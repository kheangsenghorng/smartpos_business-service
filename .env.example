APP_NAME="SmartPOS Business"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.smartpos.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=smartpos
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/smartpos
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

L5_SWAGGER_CONST_HOST=http://localhost:8002

JWT_SECRET=
JWT_ALGO=RS256
JWT_PUBLIC_KEY=file://storage/certs/jwt-public.pem
JWT_ISSUER=smartpos-auth-service
JWT_AUDIENCE=smartpos-api
# SEC-01: Set both to true in production to enforce cross-service token validation
JWT_VERIFY_ISSUER=true
JWT_VERIFY_AUDIENCE=false
IDENTITY_SERVICE_URL=http://identity-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000

FRONTEND_URL=http://localhost:3000
POS_CLIENT_URL=http://localhost:3001
